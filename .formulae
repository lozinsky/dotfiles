#!/usr/bin/env bash

should_brew_install() {
  ! brew list | grep "$1" >/dev/null
}

if should_brew_install starship
then
  brew install --no-ask starship

  mkdir -p "$HOME/.config"

  ln -sf "$DOTFILES/.config/starship.toml" "$HOME/.config/starship.toml"
fi

if should_brew_install zsh-autosuggestions
then
  brew install --no-ask zsh-autosuggestions
fi

if should_brew_install zsh-syntax-highlighting
then
  brew install --no-ask zsh-syntax-highlighting
fi

if should_brew_install git
then
  brew install --no-ask git

  ln -sf "$DOTFILES/.config/gitconfig" "$HOME/.gitconfig"
  ln -sf "$DOTFILES/.config/gitignore" "$HOME/.gitignore"
fi

if should_brew_install mise
then
  brew install --no-ask mise

  mkdir -p "$HOME/.config/mise"

  ln -sf "$DOTFILES/.config/mise/config.toml" "$HOME/.config/mise/config.toml"
  ln -sf "$DOTFILES/.config/default-npm-packages" "$HOME/.default-npm-packages"
  ln -sf "$DOTFILES/.config/npmrc" "$HOME/.npmrc"
  ln -sf "$DOTFILES/.config/oxfmtrc.json" "$HOME/.oxfmtrc.json"

  mise -y install
fi

if should_brew_install docker
then
  brew install --no-ask docker

  mkdir -p "$HOME/.docker"

  ln -sf "$DOTFILES/.config/docker/config.json" "$HOME/.docker/config.json"
fi

if should_brew_install docker-buildx
then
  brew install --no-ask docker-buildx
fi

if should_brew_install colima
then
  brew install --no-ask colima
  brew services start colima
fi

if should_brew_install mole
then
  brew install --no-ask mole
fi

if should_brew_install ollama
then
  brew install --no-ask ollama
  brew services start ollama
fi

if should_brew_install webp
then
  brew install --no-ask webp
fi
