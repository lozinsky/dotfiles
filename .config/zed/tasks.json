[
  {
    "label": "sublime merge: open",
    "command": "smerge",
    "args": ["."],
    "hide": "on_success",
  },
  {
    "label": "git: worktreeinclude",
    "command": "git-worktreeinclude",
    "args": ["$ZED_MAIN_GIT_WORKTREE", "$ZED_WORKTREE_ROOT"],
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success",
  },
]
