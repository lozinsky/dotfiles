[
  {
    "label": "sublime merge: open",
    "command": "smerge",
    "args": ["."],
    "reveal": "never",
    "hide": "on_success",
  },
  {
    "label": "git: worktreeinclude",
    "command": "git-worktreeinclude",
    "args": ["$ZED_MAIN_GIT_WORKTREE", "$ZED_WORKTREE_ROOT"],
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success",
  },
  {
    "label": "git: amend and continue rebase",
    "command": "git add -A && git commit --amend --no-edit && git rebase --continue",
    "hide": "on_success",
  },
  {
    "label": "git: continue rebase",
    "command": "git add -A && GIT_EDITOR=true git rebase --continue",
    "hide": "on_success",
  },
  {
    "label": "git: skip commit in rebase",
    "command": "git rebase --skip",
    "hide": "on_success",
  },
  {
    "label": "git: abort rebase",
    "command": "git rebase --abort",
    "hide": "on_success",
  },
  {
    "label": "Edit Commit",
    "command": "git -c core.abbrev=40 -c sequence.editor=\"sed -i '' 's/^pick $ZED_GIT_SHA/edit $ZED_GIT_SHA/'\" rebase -i --autostash $ZED_GIT_SHA~",
    "cwd": "$ZED_GIT_REPOSITORY_PATH",
    "tags": ["git-command"],
    "hide": "on_success",
  },
  {
    "label": "Rebase Onto $ZED_GIT_REF",
    "command": "git rebase --autostash $ZED_GIT_REF",
    "cwd": "$ZED_GIT_REPOSITORY_PATH",
    "tags": ["git-command"],
    "hide": "on_success",
  },
  {
    "label": "Move Commit Up",
    "command": "git -c sequence.editor=\"perl -i -0pe 's/^(.+\\n)(.+\\n)/\\$2\\$1/'\" rebase -i --autostash $ZED_GIT_SHA~",
    "cwd": "$ZED_GIT_REPOSITORY_PATH",
    "tags": ["git-command"],
    "hide": "on_success",
  },
  {
    "label": "Move Commit Down",
    "command": "git -c sequence.editor=\"perl -i -0pe 's/^(.+\\n)(.+\\n)/\\$2\\$1/'\" rebase -i --autostash $ZED_GIT_SHA~2",
    "cwd": "$ZED_GIT_REPOSITORY_PATH",
    "tags": ["git-command"],
    "hide": "on_success",
  },
  {
    "label": "Revert Commit",
    "command": "git revert --no-edit $ZED_GIT_SHA",
    "cwd": "$ZED_GIT_REPOSITORY_PATH",
    "tags": ["git-command"],
    "hide": "on_success",
  },
  {
    "label": "Drop Commit",
    "command": "git rebase --autostash --onto $ZED_GIT_SHA~ $ZED_GIT_SHA",
    "cwd": "$ZED_GIT_REPOSITORY_PATH",
    "tags": ["git-command"],
    "hide": "on_success",
  },
]
