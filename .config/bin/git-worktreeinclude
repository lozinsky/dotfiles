#!/usr/bin/env bash

set -euo pipefail

log() {
  printf '%s\n' "$*" >&2
}

if [[ $# -ne 2 ]]; then
  echo "Usage: $(basename "$0") <source-worktree> <target-worktree>" >&2
  exit 1
fi

source_worktree="$1"
target_worktree="$2"

if [[ ! -d "$source_worktree" ]]; then
  echo "Error: source worktree does not exist: $source_worktree" >&2
  exit 1
fi

if [[ ! -d "$target_worktree" ]]; then
  echo "Error: target worktree does not exist: $target_worktree" >&2
  exit 1
fi

source_worktree="$(cd "$source_worktree" && pwd)"
target_worktree="$(cd "$target_worktree" && pwd)"

log "$source_worktree -> $target_worktree"

files=()
while IFS= read -r -d '' rel_path; do
  files+=("$rel_path")
done < <(git -C "$source_worktree" ls-files -z --others --ignored --exclude-per-directory=.worktreeinclude)

if (( ${#files[@]} == 0 )); then
  log "done: no matching files"
  exit 0
fi

printf '%s\0' "${files[@]}" \
  | tar --null -T - -cf - -C "$source_worktree" \
  | tar -xf - -C "$target_worktree"

log "done: ${#files[@]} file(s) copied"
