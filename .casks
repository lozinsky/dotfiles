#!/usr/bin/env bash

should_brew_install_cask() {
  ! brew list --cask | grep "$1" >/dev/null
}

if should_brew_install_cask google-chrome
then
  brew install --no-ask --cask google-chrome
fi

if should_brew_install_cask zed
then
  brew install --no-ask --cask zed

  mkdir -p "$HOME/.config/zed"

  ln -sf "$DOTFILES/.config/zed/settings.json" "$HOME/.config/zed/settings.json"
  ln -sf "$DOTFILES/.config/zed/keymap.json" "$HOME/.config/zed/keymap.json"
  ln -sf "$DOTFILES/.config/zed/tasks.json" "$HOME/.config/zed/tasks.json"

  mkdir -p "$HOME/.config/zed/snippets"

  ln -sf "$DOTFILES/.config/zed/snippets/javascript.json" "$HOME/.config/zed/snippets/javascript.json"
  ln -sf "$DOTFILES/.config/zed/snippets/typescript.json" "$HOME/.config/zed/snippets/typescript.json"
fi

if should_brew_install_cask sublime-merge
then
  brew install --no-ask --cask sublime-merge

  read -s -p "To continue, you need to open Sublime Merge.app manually. Press RETURN if you are done."; echo

  ln -sf "$DOTFILES/.config/smerge/Preferences.sublime-settings" "$HOME/Library/Application Support/Sublime Merge/Packages/User/Preferences.sublime-settings"
fi

if should_brew_install_cask telegram
then
  brew install --no-ask --cask telegram
fi

if should_brew_install_cask iina
then
  brew install --no-ask --cask iina
fi

if should_brew_install_cask bitwarden
then
  brew install --no-ask --cask bitwarden
fi

if should_brew_install_cask obsidian
then
  brew install --no-ask --cask obsidian
fi

if should_brew_install_cask maccy
then
  brew install --no-ask --cask maccy

  defaults write org.p0deje.Maccy KeyboardShortcuts_popup -string "{\"carbonModifiers\":768,\"carbonKeyCode\":9}"
  defaults write org.p0deje.Maccy hideFooter -bool true
  defaults write org.p0deje.Maccy hideTitle -bool true
  defaults write org.p0deje.Maccy pasteByDefault -bool true
  defaults write org.p0deje.Maccy supressClearAlert -bool true
  defaults write org.p0deje.Maccy showInStatusBar -bool false
  defaults write org.p0deje.Maccy popupPosition -string "center"
  defaults write org.p0deje.Maccy historySize -int 10
  defaults write org.p0deje.Maccy ignoredApps -array "com.bitwarden.desktop"
fi

if should_brew_install_cask keyboardcleantool
then
  brew install --no-ask --cask keyboardcleantool
fi

if should_brew_install_cask font-maple-mono
then
  brew install --no-ask --cask font-maple-mono
fi

if should_brew_install_cask terminal-browser
then
  brew install --no-ask --cask terminal-browser

  mkdir -p "$HOME/.config/terminal-browser"

  ln -sf "$DOTFILES/.config/terminal-browser/settings.json" "$HOME/.config/terminal-browser/settings.json"
fi

if should_brew_install_cask claude-code@latest
then
  brew install --no-ask --cask claude-code@latest

  mkdir -p "$HOME/.claude"

  ln -sf "$DOTFILES/.config/claude/settings.json" "$HOME/.claude/settings.json"

  claude plugin install ponytail@ponytail

  claude mcp add --scope user safari-devtools -- /usr/bin/safaridriver --mcp
  claude mcp add --scope user context7 -- mcp-keychain mcp.context7.api-key -- mcp-remote https://mcp.context7.com/mcp --header "CONTEXT7_API_KEY: {1}"
  claude mcp add --scope user github -- mcp-keychain mcp.github.personal-access-token -- mcp-remote https://api.githubcopilot.com/mcp/readonly --header "Authorization: Bearer {1}"
  claude mcp add --scope user --transport http mdn https://mcp.mdn.mozilla.net
  claude mcp add --scope user --transport http superlogical https://www.superlogical.com/rex/community-mcp
fi

if should_brew_install_cask happ
then
  brew install --no-ask --cask happ
fi

mkdir -p "$HOME/.config/rex"

ln -sf "$DOTFILES/.config/rex/init.lua" "$HOME/.config/rex/init.lua"

defaults write com.superlogical.rex Workspace.appearance -string "dark"
defaults write com.superlogical.rex Workspace.interfaceStyle -string "useTheme"
defaults write com.superlogical.rex Workspace.darkThemeID -string "custom-D4458190-7136-4561-9776-209CB8BAB5BA"
defaults write com.superlogical.rex Workspace.terminalFontName -string "Maple Mono"
defaults write com.superlogical.rex Workspace.terminalFontPointSize -int 14
defaults write com.superlogical.rex Workspace.terminalUsesDisplayP3 -bool true
defaults write com.superlogical.rex Workspace.cursorShadersEnabled -bool true
defaults write com.superlogical.rex Workspace.tabStyle -string "vertical"
defaults write com.superlogical.rex Workspace.sidebarPosition -string "left"
defaults write com.superlogical.rex Workspace.sidebarSwipe -string "optionSwipe"
defaults write com.superlogical.rex Workspace.appIcon -string "dark"
defaults write com.superlogical.rex Workspace.appIconVisibility -string "dockOnly"
defaults write com.superlogical.rex Workspace.showsActivePaneBorder -bool true
defaults write com.superlogical.rex Workspace.activePaneBorderColor -string "magenta"
defaults write com.superlogical.rex Workspace.terminalCopyOnSelect -bool true
defaults write com.superlogical.rex Workspace.terminalSmoothScrolling -bool true
defaults write com.superlogical.rex Workspace.customThemes -data "$(xxd -p "$DOTFILES/.config/rex/themes.json" | tr -d '\n')"
